# /etc/sub2api-cursor-sidecar/sidecar.env

HOST=127.0.0.1
PORT=8090

# sub2api root URL (without /v1)
SUB2API_BASE_URL=http://127.0.0.1:8080
# Keep the client Host header when proxying (matches a direct nginx -> sub2api hop)
UPSTREAM_PRESERVE_HOST=true
# Optional: override User-Agent / add Originator on rewritten Cursor requests
UPSTREAM_USER_AGENT=
UPSTREAM_ORIGINATOR=

# Used when a Cursor request has no model / no reasoning effort
DEFAULT_MODEL=gpt-5.4
DEFAULT_REASONING_EFFORT=medium

# Audit logs (contain prompts; stored under DATA_DIR/logs)
CURSOR_AUDIT_LOG_ENABLED=false
UPSTREAM_AUDIT_LOG_ENABLED=false
