# /etc/sub2api-cursor-sidecar/sidecar.env
# sub2api-cursor-sidecar 运行配置（由 systemd EnvironmentFile 加载，修改后执行
#   systemctl restart sub2api-cursor-sidecar
# 生效）。链路：nginx -> sidecar(本服务) -> sub2api

# ---------------------------------------------------------------------------
# 监听地址：只给本机 nginx 访问，不要对外暴露
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8090

# ---------------------------------------------------------------------------
# 上游 sub2api
# ---------------------------------------------------------------------------
# sub2api 根地址，不要带 /v1（sub2api 默认端口 8080，按实际修改）
SUB2API_BASE_URL=http://127.0.0.1:8080

# 反代时保留客户端原始 Host 头（等同于 nginx 直连 sub2api 时的行为）
UPSTREAM_PRESERVE_HOST=true

# 可选：仅对"改写后的 Cursor 请求"生效。
# 若 sub2api 的 OAuth 账号限制只允许 Codex 客户端，可伪装为 Codex CLI，例如：
#   UPSTREAM_USER_AGENT="codex_cli_rs/0.47.0 (Linux; x86_64)"
# （含空格/括号的值请加双引号，systemd 与 install.sh 都能正确解析）
#   UPSTREAM_ORIGINATOR=codex_cli_rs
# 留空则透传 Cursor 自己的 User-Agent。
UPSTREAM_USER_AGENT=
UPSTREAM_ORIGINATOR=

# ---------------------------------------------------------------------------
# Cursor 请求默认值
# ---------------------------------------------------------------------------
# Cursor 请求未带 model 时使用
DEFAULT_MODEL=gpt-5.4

# 全局兜底思考强度：请求未显式指定、sidecar.yaml 的映射和 reasoning_defaults
# 也都没有命中时使用。可选 none | minimal | low | medium | high | xhigh
DEFAULT_REASONING_EFFORT=medium

# 在 instructions 前注入一段兼容层说明，一般保持 false
INJECT_DESKTOP_CONTEXT=false

# ---------------------------------------------------------------------------
# 模型映射配置（虚拟模型名 -> 上游模型 + 强度）
# systemd 单元已设置 SIDECAR_CONFIG=/etc/sub2api-cursor-sidecar/sidecar.yaml，
# 这里无需重复；本地手动运行时可取消注释。
# ---------------------------------------------------------------------------
# SIDECAR_CONFIG=/etc/sub2api-cursor-sidecar/sidecar.yaml

# ---------------------------------------------------------------------------
# 审计日志（jsonl，写入 DATA_DIR/logs/，单文件满 100MB 自动轮转并 gzip）
# 注意：日志包含完整提示词和模型输出，Authorization 等密钥头会脱敏。
# 排查问题时临时打开，平时建议关闭。
# ---------------------------------------------------------------------------
# Cursor 入站原始请求 -> cursor-audit.jsonl
CURSOR_AUDIT_LOG_ENABLED=false
# sidecar 发往 sub2api 的改写后请求及错误响应 -> upstream-audit.jsonl
UPSTREAM_AUDIT_LOG_ENABLED=false
# systemd 单元已设置 DATA_DIR=/var/lib/sub2api-cursor-sidecar
# CURSOR_AUDIT_LOG_FILE=
# UPSTREAM_AUDIT_LOG_FILE=
