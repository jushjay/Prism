# /etc/sub2api-cursor-sidecar/sidecar.env
# sub2api-cursor-sidecar 运行配置（由 systemd EnvironmentFile 加载，修改后执行
#   systemctl restart sub2api-cursor-sidecar
# 生效）。链路：nginx -> sidecar(本服务) -> sub2api
#
# sidecar 不做鉴权：客户端的 Authorization（sub2api API Key）原样转发给 sub2api 校验。
# 模型与思考强度（每个模型一一对应）在 sidecar.yaml 中配置，不在这里。

# 监听地址：只给本机 nginx 访问，不要对外暴露
HOST=127.0.0.1
PORT=8090

# sub2api 根地址，不要带 /v1（sub2api 默认端口 8080，按实际修改）
SUB2API_BASE_URL=http://127.0.0.1:8080

# 反代时保留客户端原始 Host 头（等同于 nginx 直连 sub2api 时的行为）
UPSTREAM_PRESERVE_HOST=true

# 审计日志（jsonl，写入 DATA_DIR/logs/，单文件满 100MB 自动轮转并 gzip）
# 日志包含完整提示词，Authorization 等密钥头会脱敏；排查问题时临时打开。
# Cursor 入站原始请求 -> cursor-audit.jsonl
CURSOR_AUDIT_LOG_ENABLED=false
# sidecar 发往 sub2api 的改写后请求及错误响应 -> upstream-audit.jsonl
UPSTREAM_AUDIT_LOG_ENABLED=false

# 以下由 systemd 单元设置，一般无需修改：
#   SIDECAR_CONFIG=/etc/sub2api-cursor-sidecar/sidecar.yaml
#   DATA_DIR=/var/lib/sub2api-cursor-sidecar
