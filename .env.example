# sub2api-cursor-sidecar configuration
# Copy to .env for local runs: cp .env.example .env

# Listen address (nginx -> sidecar)
HOST=127.0.0.1
PORT=8090

# sub2api root URL (without /v1)
SUB2API_BASE_URL=http://127.0.0.1:8080
UPSTREAM_PRESERVE_HOST=true
UPSTREAM_USER_AGENT=
UPSTREAM_ORIGINATOR=

# Cursor request defaults
DEFAULT_MODEL=gpt-5.4
DEFAULT_REASONING_EFFORT=medium
INJECT_DESKTOP_CONTEXT=false

# Model mappings / per-model reasoning defaults (default: server/configs/sidecar.yaml)
SIDECAR_CONFIG=

# Runtime data directory for audit logs (default: ./data)
DATA_DIR=

# Audit logging. These logs contain prompts and responses.
CURSOR_AUDIT_LOG_ENABLED=false
UPSTREAM_AUDIT_LOG_ENABLED=false
